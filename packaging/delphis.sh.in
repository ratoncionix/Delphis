#!/bin/sh
# Delphis GUI launcher.
# Generated by `make install` from packaging/delphis.sh.in.
LIBDIR="@LIBDIR@"
BINDIR="@BINDIR@"

# Python interpreter that has PyQt6 available (override with $DELPHIS_PYTHON).
if [ -n "${DELPHIS_PYTHON:-}" ]; then
    PYTHON="$DELPHIS_PYTHON"
else
    PYTHON="@PYTHON@"
    if ! "$PYTHON" -c "import PyQt6" >/dev/null 2>&1; then
        DATA_DIR="${DELPHIS_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/delphis}"
        if [ -x "$DATA_DIR/venv/bin/python" ]; then
            PYTHON="$DATA_DIR/venv/bin/python"
        fi
    fi
fi

case ":${PATH}:" in
    *":${BINDIR}:"*) ;;
    *) PATH="${BINDIR}:${PATH}"; export PATH ;;
esac

PYTHONPATH="$LIBDIR/python${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec "$PYTHON" -m delphis_gui "$@"
