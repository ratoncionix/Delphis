#!/bin/sh
# Delphis launcher for a bundled .NET executable (@NAME@).
# Generated by `make install` from packaging/dotnet-launcher.sh.in.
LIBDIR="@LIBDIR@"
BINDIR="@BINDIR@"
TARGET="$LIBDIR/@REL_EXE@"

# Make the other Delphis tools (e.g. dte) visible to child processes.
case ":${PATH}:" in
    *":${BINDIR}:"*) ;;
    *) PATH="${BINDIR}:${PATH}"; export PATH ;;
esac

# Self-contained build: the runtime ships next to the executable.
if [ -e "$(dirname "$TARGET")/libhostfxr.so" ]; then
    exec "$TARGET" "$@"
fi

# Framework-dependent build: run the assembly with the installed .NET host.
# Using `dotnet <app>.dll` instead of the native apphost also works on systems
# without a standard FHS dynamic loader (e.g. NixOS).
DOTNET="${DELPHIS_DOTNET:-@DOTNET_HOST@}"
if [ -z "$DOTNET" ]; then
    if [ -n "${DOTNET_ROOT:-}" ] && [ -x "${DOTNET_ROOT}/dotnet" ]; then
        DOTNET="${DOTNET_ROOT}/dotnet"
    elif command -v dotnet >/dev/null 2>&1; then
        DOTNET=$(command -v dotnet)
    elif [ -x "${HOME}/.dotnet/dotnet" ]; then
        DOTNET="${HOME}/.dotnet/dotnet"
    fi
fi

if [ -n "$DOTNET" ]; then
    exec "$DOTNET" "$TARGET.dll" "$@"
fi

# Last resort: the native apphost searches the default .NET install locations.
exec "$TARGET" "$@"
